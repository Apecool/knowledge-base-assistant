# ============================================
# Knowledge Base Assistant — Environment Template
# Copy this to .env and fill in your values
# ============================================

# Application
APP_NAME=知识库助手
DEBUG=True

# Database — SQLite (dev)
DATABASE_URL=sqlite:///./knowledge_base.db

# For Render / Supabase PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# CORS — add your production domain
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://kb-assistant.vercel.app"]

# JWT — CHANGE THIS in production
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Provider — "openai" or "deepseek"
LLM_PROVIDER=deepseek

# OpenAI (only if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek (only if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db

# Monitoring (optional — leave empty to disable)
SENTRY_DSN=
LOGTAIL_TOKEN=